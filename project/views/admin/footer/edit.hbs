<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-edit me-2"></i> Cấu Hình Footer Hệ Thống</h5>
        </div>
        <div class="card-body">
            <form action="/admin/footer/save" method="post">

                <h6 class="text-uppercase fw-bold text-muted mb-3">1. Thông tin chung</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Tên cửa hàng</label>
                        <input type="text" name="shopName" class="form-control" value="{{footer.shopName}}" placeholder="Ví dụ: My Shop">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Slogan</label>
                        <input type="text" name="slogan" class="form-control" value="{{footer.slogan}}" placeholder="Châm ngôn kinh doanh">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Hotline</label>
                        <input type="text" name="hotline" class="form-control" value="{{footer.hotline}}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control" value="{{footer.email}}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Giờ mở cửa</label>
                        <input type="text" name="openHours" class="form-control" value="{{footer.openHours}}">
                    </div>
                    <div class="col-12">
                        <label class="form-label">Địa chỉ</label>
                        <input type="text" name="address" class="form-control" value="{{footer.address}}">
                    </div>
                </div>

                <hr>

                <h6 class="text-uppercase fw-bold text-muted mb-3">2. Liên kết hỗ trợ</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <input type="text" name="support1" class="form-control" value="{{footer.support1}}" placeholder="Hỗ trợ 1">
                    </div>
                    <div class="col-md-3">
                        <input type="text" name="support2" class="form-control" value="{{footer.support2}}" placeholder="Hỗ trợ 2">
                    </div>
                    <div class="col-md-3">
                        <input type="text" name="support3" class="form-control" value="{{footer.support3}}" placeholder="Hỗ trợ 3">
                    </div>
                    <div class="col-md-3">
                        <input type="text" name="support4" class="form-control" value="{{footer.support4}}" placeholder="Hỗ trợ 4">
                    </div>
                </div>

                <hr>

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label">Tag nổi bật 1</label>
                        <input type="text" name="tag1" class="form-control" value="{{footer.tag1}}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Tag nổi bật 2</label>
                        <input type="text" name="tag2" class="form-control" value="{{footer.tag2}}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Copyright</label>
                        <input type="text" name="copyright" class="form-control" value="{{footer.copyright}}">
                    </div>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <button type="submit" class="btn btn-success px-5 shadow-sm">
                        <i class="fas fa-save me-2"></i> Lưu Cấu Hình Footer
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>