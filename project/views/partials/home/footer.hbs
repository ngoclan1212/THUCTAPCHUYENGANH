<footer class="footer-modern">
    <div class="container">
        <div class="row text-white">

            <div class="col-md-4">
                <h5 class="footer-title">THÔNG TIN LIÊN HỆ</h5>
                <p class="footer-shop">{{footer.shopName}}</p>
                <p class="footer-slogan">{{footer.slogan}}</p>

                <ul class="footer-contact">
                    <li><i class="bi bi-geo-alt"></i> {{footer.address}}</li>
                    <li><i class="bi bi-telephone"></i> {{footer.hotline}}</li>
                    <li><i class="bi bi-envelope"></i> {{footer.email}}</li>
                    <li><i class="bi bi-clock"></i> {{footer.openHours}}</li>
                </ul>
            </div>

            <div class="col-md-4">
                <h5 class="footer-title text-center">HỖ TRỢ KHÁCH HÀNG</h5>
                <ul class="footer-links text-center">
                    <li>{{footer.support1}}</li>
                    <li>{{footer.support2}}</li>
                    <li>{{footer.support3}}</li>
                    <li>{{footer.support4}}</li>
                </ul>
            </div>

            <div class="col-md-4 text-end">
                <h5 class="footer-title">TÌM KIẾM NHIỀU NHẤT</h5>
                <div class="footer-tags">
                    <span>{{footer.tag1}}</span>
                    <span>{{footer.tag2}}</span>
                </div>
            </div>
        </div>

        <div class="footer-bottom text-center mt-4">
            © {{footer.copyright}}
        </div>
    </div>
</footer>
