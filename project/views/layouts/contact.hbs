<section class="contact-page">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6 text-center">
                <img src="/img/11.jpg" alt="About N&Fresh Flowers" class="img-fluid contact-img">
            </div>

            <div class="col-lg-6">
                <h2 class="intro-title">Về N&Fresh Flowers</h2>
                <div class="intro-text">
                    <p>{{{contact.description}}}</p>

                    <ul class="list-unstyled feature-list mb-4">
                        <li><i class="bi bi-check2-circle"></i> <strong>Sản phẩm tỉ mỉ:</strong> Mỗi sản phẩm đều là tác phẩm của sự tâm huyết.</li>
                        <li><i class="bi bi-check2-circle"></i> <strong>Giao hàng tốc hành:</strong> Đảm bảo hoa tươi đến tay bạn đúng hẹn.</li>
                        <li><i class="bi bi-check2-circle"></i> <strong>Giá cả hợp lý:</strong> Mang cái đẹp đến mọi nhà với chi phí tối ưu.</li>
                    </ul>
                </div>

                <div class="contact-details shadow-sm">
                    <h5 class="mb-3" style="color: #0d47a1;">Thông Tin Liên Hệ</h5>
                    <p class="mb-2">
                        <i class="bi bi-geo-alt-fill me-2"></i>
                        <strong>Địa chỉ:</strong>
                        <a href="{{contact.googleMapsUrl}}" target="_blank" class="text-decoration-none text-dark">
                            {{contact.address}}
                        </a>
                    </p>

                    <p class="mb-2">
                        <i class="bi bi-telephone-fill me-2"></i>
                        <strong>Hotline:</strong>
                        <a href="tel:{{contact.hotline}}" class="text-decoration-none text-dark">
                            {{contact.hotline}}
                        </a>
                    </p>

                    {{#if contact.email}}
                        <p class="mb-2">
                            <i class="bi bi-envelope-fill me-2"></i>
                            <strong>Email:</strong>
                            <a href="mailto:{{contact.email}}"
                               onclick="window.open('https://mail.google.com/mail/?view=cm&fs=1&to={{contact.email}}')"
                                class="text-decoration-none text-dark">
                                {{contact.email}}
                            </a>
                        </p>
                    {{else}}
                        <p class="mb-2 text-muted">
                            <i class="bi bi-envelope-fill me-2"></i>
                            <strong>Email:</strong> Đang cập nhật
                        </p>
                    {{/if}}

                    <p class="mb-0"><i class="bi bi-clock-fill me-2"></i> <strong>Giờ làm việc:</strong> {{contact.workingHours}}</p>
                </div>

                <div class="mt-4">
                    <a href="/shop" class="btn btn-primary px-4 py-2 shadow-sm" style="background-color: #0d47a1; border: none;">Khám phá cửa hàng</a>
                    <a href="/" class="btn btn-outline-secondary px-4 py-2 ms-2">Trang chủ</a>
                </div>
            </div>
        </div>
    </div>
</section>